{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "producer": {
      "type": "string",
      "const": "muse-rotation-evidence"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{4,95}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "backfill",
        "daily",
        "weekly_review"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "replaces_batches": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{4,95}$"
      }
    },
    "campaign": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{4,95}$"
        },
        "edition_dates": {
          "minItems": 1,
          "maxItems": 5000,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      },
      "required": [
        "id",
        "edition_dates"
      ],
      "additionalProperties": false
    },
    "pages": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "family": {
            "type": "string",
            "enum": [
              "index",
              "chart",
              "edition",
              "artist",
              "song",
              "map",
              "dig",
              "culture",
              "pressing",
              "methodology",
              "changelog",
              "analyzer"
            ]
          },
          "source_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "acquisition": {
            "type": "string",
            "enum": [
              "live_public",
              "preserved_public_capture"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "captured",
              "partial",
              "blocked",
              "unavailable",
              "not_applicable"
            ]
          },
          "observed_rows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "expected_rows": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              {
                "type": "null"
              }
            ]
          },
          "observations": {
            "maxItems": 1200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "project": {
                  "type": "string",
                  "enum": [
                    "hyperidol",
                    "suga"
                  ]
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "kpop",
                    "broader_music",
                    "unresolved"
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "chart_entry",
                    "recording",
                    "artist",
                    "country_history",
                    "city_pickup",
                    "musical_measurement",
                    "credit",
                    "culture_context",
                    "editorial",
                    "methodology"
                  ]
                },
                "subject": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "facts": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 600
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      {
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 600
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                "classification": {
                  "type": "object",
                  "properties": {
                    "named_credit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "artists": {
                      "minItems": 1,
                      "maxItems": 12,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "identity_source": {
                            "type": "string",
                            "format": "uri"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "identity_source"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "named_credit",
                    "artists"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "project",
                "scope",
                "kind",
                "subject",
                "facts"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "url",
          "family",
          "source_date",
          "captured_at",
          "status",
          "observed_rows",
          "expected_rows",
          "observations"
        ],
        "additionalProperties": false
      }
    },
    "review_items": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "enum": [
              "hyperidol",
              "suga"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": [
              "chart_entry",
              "recording",
              "artist",
              "country_history",
              "city_pickup",
              "musical_measurement",
              "credit",
              "culture_context",
              "editorial",
              "methodology"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "before": {
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 600
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 600
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 600
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 600
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              ]
            }
          },
          "evidence_indexes": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "required": [
          "project",
          "subject",
          "kind",
          "summary",
          "before",
          "after",
          "evidence_indexes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "producer",
    "batch_id",
    "phase",
    "captured_at",
    "pages",
    "review_items"
  ],
  "additionalProperties": false
}
